TZ=Asia/Shanghai

# 必须与中央 hosts.txt、公共 REST 用户名和 URL 路径完全一致。
# 示例：vps-example-01
RESTIC_HOST=CHANGE_ME_HOSTNAME

# 示例格式：rest:https://backup.example.com/vps-example-01/
RESTIC_REPOSITORY=CHANGE_ME_PUBLIC_REPOSITORY_URL

# 每台 VPS 使用独立的 Healthchecks.io ping URL。
HEALTHCHECKS_URL=CHANGE_ME_HEALTHCHECKS_PING_URL
