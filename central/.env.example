PUID=10001
PGID=10001
TZ=Asia/Shanghai

RCLONE_REMOTE=backup-onedrive-crypt:restic
# 示例：backup.example.com
BACKUP_DOMAIN=CHANGE_ME_BACKUP_DOMAIN
# 示例：websecure
TRAEFIK_ENTRYPOINT=CHANGE_ME_TRAEFIK_ENTRYPOINT

RESTIC_ADMIN_USERNAME=restic-admin

# 以下保留参数尚未确认。部署前必须全部替换，不能保留 CHANGE_ME。
# KEEP_WITHIN 是 append-only 威胁模型下的强制安全窗口，不能留空或设为 0。
# 一组偏均衡的示例：7 / 14 / 8 / 12 / 2 / 14d；示例不是最终值。
KEEP_LAST=CHANGE_ME_KEEP_LAST
KEEP_DAILY=CHANGE_ME_KEEP_DAILY
KEEP_WEEKLY=CHANGE_ME_KEEP_WEEKLY
KEEP_MONTHLY=CHANGE_ME_KEEP_MONTHLY
KEEP_YEARLY=CHANGE_ME_KEEP_YEARLY
KEEP_WITHIN=CHANGE_ME_KEEP_WITHIN

# 示例：5%；也可使用 1/20。具体比例尚未确认。
CHECK_READ_DATA_SUBSET=CHANGE_ME_CHECK_READ_DATA_SUBSET
